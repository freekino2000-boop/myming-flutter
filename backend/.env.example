PORT=3000
NODE_ENV=development
DATABASE_URL=postgresql://postgres:your_password@localhost:5432/myming_db
JWT_SECRET=your_jwt_secret_32chars_here
JWT_REFRESH_SECRET=your_refresh_secret_32chars
JWT_EXPIRES_IN=1h
JWT_REFRESH_EXPIRES_IN=7d
# 프로덕션: 허용할 도메인 콤마 구분 (미설정 시 모든 origin 허용)
# ALLOWED_ORIGINS=https://myming.app,https://www.myming.app
